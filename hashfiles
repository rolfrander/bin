def recursive_get(d, *keys):
    return reduce(lambda c, k: c.get(k, {}), keys, d)

def md5_metadata(filename):
    if filename.endswith(".mp3") or filename.endswith(".flac"):
        m = audio_metadata.load(filename)
        streaminfo_md5 = recursive_get(m, "streaminfo", "md5")
        if streaminfo_md5:
            return streaminfo_md5
        
        usertext = recursive_get(m, "tags", "usertext")
        if usertext:
            for e in usertext:
                if e["description"] == "MD5":
                    return e["text"][0]

    return None

def compute_checksum(path, algorithm="sha256"):
    h = hashlib.new(algorithm)
    try:
        with open(path, "rb") as f:
            while chunk := f.read(CHUNK_SIZE):
                h.update(chunk)
        return h.hexdigest()
    except Exception as e:
        return None


def init_db(conn):
    conn.execute("""
    CREATE TABLE IF NOT EXISTS files (
        path TEXT,
        host TEXT,
        checksum TEXT,
        algo TEXT,
        metadata_md5 TEXT,
        size BIGINT,
        mtime REAL,
        ctime REAL,
        inode INTEGER,
        device INTEGER,
        mode INTEGER,
        uid INTEGER,
        gid INTEGER,
        scanned_at TEXT,
        PRIMARY KEY(host,path)
    )
    """)

    conn.execute("CREATE INDEX IF NOT EXISTS idx_checksum ON files(checksum)")
    conn.execute("CREATE INDEX IF NOT EXISTS idx_host     ON files(host)")
    conn.execute("CREATE INDEX IF NOT EXISTS idx_md5      ON files(metadata_md5)")
    conn.commit()

  
def upsert_file(conn, record):
    conn.execute("""
    INSERT INTO files (
        path, host, checksum, algo, metadata_md5, size, mtime, ctime,
        inode, device, mode, uid, gid, scanned_at
    )
    VALUES (%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s)
    ON CONFLICT(host,path) DO UPDATE SET
        checksum=excluded.checksum,
        host=excluded.host,
        algo=excluded.algo,
        metadata_md5=excluded.metadata_md5,
        size=excluded.size,
        mtime=excluded.mtime,
        ctime=excluded.ctime,
        inode=excluded.inode,
        device=excluded.device,
        mode=excluded.mode,
        uid=excluded.uid,
        gid=excluded.gid,
        scanned_at=excluded.scanned_at
    """, record)

def is_scanned(conn, hostname, path):
    with conn.execute("select checksum from files where host=%s and path=%s", [hostname, path]) as cursor:
        if cursor.rowcount > 0:
            return True
        else:
            return False
        

def scan_directory(root, conn, algo):
    abs_root = os.path.abspath(root)
    hostname = socket.gethostname()
    for dirpath, dirnames, filenames in os.walk(abs_root):
        for name in filenames:
            full_path = os.path.join(dirpath, name)
            if not is_scanned(conn, hostname, full_path):
                try:
                    stat = os.stat(full_path, follow_symlinks=False)
                    checksum = compute_checksum(full_path, algo)

                    record = (
                        full_path,
                        hostname,
                        checksum,
                        algo,
                        md5_metadata(full_path),
                        stat.st_size,
                        stat.st_mtime,
                        stat.st_ctime,
                        stat.st_ino,
                        stat.st_dev,
                        stat.st_mode,
                        stat.st_uid,
                        stat.st_gid,
                        datetime.now(UTC).isoformat()
                    )
                    upsert_file(conn, record)
                except Exception as e:
                    print(f"[WARN] DB insert failed: {full_path} ({e})", file=sys.stderr)

            conn.commit()  # commit per directory for durability


def main():
    parser = argparse.ArgumentParser(description="Recursive file hasher to SQLite")
    parser.add_argument("directory", help="Directory to scan")
    parser.add_argument("--db", help="PostgreSQL connection string, postgresql://user:password@host/database")
    parser.add_argument("--algo", default="sha256", help="Hash algorithm (sha256, md5, etc.)")

    args = parser.parse_args()

    root = Path(args.directory)
    if not root.is_dir():
        print(f"Invalid directory: {root}", file=sys.stderr)
        sys.exit(1)

    # connection to postgreSQL
    # files, f1LeScaNNer
    conn = psycopg.connect(args.db)
    init_db(conn)

    try:
        scan_directory(root, conn, args.algo)
    finally:
        conn.close()


if __name__ == "__main__":
    main()
